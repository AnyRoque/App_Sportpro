rules_version = '2';

// Reglas de seguridad de SportPro (Cloud Firestore)
// Publicar en: Firebase Console > Firestore Database > Reglas
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function role() { return exists(myDoc()) ? get(myDoc()).data.role : ''; }
    function isAdmin() { return signedIn() && role() == 'ADM'; }
    function isDt() { return signedIn() && role() == 'DT'; }
    function me() { return request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Partido: DT dueño, operador asignado, DT miembro del partido o ADM (US-16 a US-21)
    function matchData(matchId) { return get(/databases/$(database)/documents/matches/$(matchId)).data; }
    function isMatchStaffOf(m) {
      return m.get('dtUid', '') == me()
        || m.get('operatorUid', '') == me()
        || (me() in m.get('memberUids', []) && isDt())
        || isAdmin();
    }
    function isMatchStaff(matchId) { return signedIn() && isMatchStaffOf(matchData(matchId)); }

    // ---------- Usuarios (US-01, US-06) ----------
    match /users/{uid} {
      allow read: if signedIn();
      // Registro público: solo DT, JUG o PAD. El ADM solo lo crea otro ADM (US-06).
      allow create: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role in ['DT', 'JUG', 'PAD'])
                    || isAdmin();
      // Nadie puede cambiar su propio rol ni reactivarse
      allow update: if (signedIn() && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.active == resource.data.active)
                    || isAdmin();
      allow delete: if false;
    }

    // ---------- Administradores (US-06): solo ADM ----------
    match /Admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ---------- Equipos (US-03, US-07) ----------
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if isDt()
                    && request.resource.data.dtUid == request.auth.uid
                    && request.resource.data.status == 'PENDIENTE';
      // El DT edita su equipo sin poder aprobarlo; el ADM aprueba o rechaza
      allow update: if isAdmin()
                    || (isDt() && resource.data.dtUid == request.auth.uid
                        && (request.resource.data.status == resource.data.status
                            || request.resource.data.status == 'PENDIENTE'));
      allow delete: if isAdmin();
    }

    // ---------- Partidos y eventos en vivo (US-16 a US-21) ----------
    match /matches/{matchId} {
      allow read: if signedIn();
      // Solo el DT programa sus partidos; marcador, cronómetro y estado los cambia el equipo técnico
      allow create: if isDt() && request.resource.data.dtUid == me();
      allow update: if signedIn() && isMatchStaffOf(resource.data);
      allow delete: if false;

      // Convocatoria (US-17): el DT la arma; el jugador o su padre solo responde la suya
      match /callups/{callUpId} {
        allow read: if signedIn();
        allow create, delete: if isMatchStaff(matchId);
        allow update: if isMatchStaff(matchId)
                      || (signedIn()
                          && (resource.data.get('userUid', '') == me() || resource.data.get('parentUid', '') == me())
                          && changed().hasOnly(['responseStatus', 'rejectReason', 'rejectComment', 'updatedAt']));
      }
      // Alineación (US-18)
      match /lineup/{lineupId} {
        allow read: if signedIn();
        allow write: if isMatchStaff(matchId);
      }
      // Eventos en vivo (US-19 / US-20)
      match /events/{eventId} {
        allow read: if signedIn();
        allow create, update: if isMatchStaff(matchId);
        allow delete: if false;   // los eventos se anulan, no se borran (US-20)
        match /history/{historyId} {
          allow read: if signedIn();
          allow create: if isMatchStaff(matchId);
          allow update, delete: if false;   // bitácora inmutable
        }
      }
    }

    // ---------- Anuncios (US-22) ----------
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if (isAdmin() || isDt()) && request.resource.data.authorUid == request.auth.uid;
      // El autor edita; cualquiera con sesión solo puede marcarlo como leído
      allow update: if (signedIn() && resource.data.authorUid == request.auth.uid)
                    || isAdmin()
                    || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    // ---------- Comunidad (US-23) y moderación (US-24) ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.status == 'VISIBLE';
      allow update: if isAdmin()
                    // El autor puede eliminar (marcar ELIMINADO) su publicación
                    || (signedIn() && resource.data.authorUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reactions', 'commentCount', 'reportCount']))
                    // Los demás: reaccionar, comentar, reportar (3 reportes la ocultan)
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount', 'reportCount', 'status'])
                        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'OCULTO'));
      allow delete: if false;   // nunca se borran físicamente
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
        allow update: if false;
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      // get de un id inexistente (para evitar doble reporte) también se permite
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.reporterUid == request.auth.uid));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- Resumen IA del partido (US-25 a US-27) ----------
    match /summaries/{matchId} {
      allow read: if signedIn();
      // Solo el DT de ESE partido genera, edita y aprueba su resumen
      allow create, update: if isDt() && matchData(matchId).dtUid == me();
      allow delete: if false;
    }

    // ---------- Jugadores (US-02, US-04, US-05) ----------
    match /players/{playerId} {
      allow read: if signedIn();
      // DT registra a sus jugadores; JUG/PAD solo crean su propia solicitud o la de su hijo
      allow create: if isAdmin()
                    || (isDt() && request.resource.data.dtUid == me())
                    || (signedIn() && request.resource.data.get('userUid', '') == me())
                    || (signedIn() && request.resource.data.get('parentUid', '') == me());
      // JUG/PAD editan solo su ficha y sin tocar vínculo, equipo ni estado
      allow update: if isAdmin() || isDt()
                    || (signedIn()
                        && (resource.data.get('userUid', '') == me() || resource.data.get('parentUid', '') == me())
                        && !changed().hasAny(['linkStatus', 'dtUid', 'teamId', 'teamName', 'active', 'userUid', 'parentUid', 'dni', 'monthlyFees']));
      allow delete: if isAdmin();

      // Historial de asistencia por jugador (US-13 / US-14)
      match /attendanceHistory/{recordId} {
        allow read: if signedIn();
        allow write: if isDt() || isAdmin();
      }
    }

    // DNI único (US-04): se consulta uno a uno, nunca se lista
    match /dniIndex/{dni} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // ---------- Entrenamientos y asistencia (US-11 a US-14) ----------
    match /trainings/{trainingId} {
      allow read: if signedIn();
      allow write: if isDt() || isAdmin();
    }
    match /attendance/{recordId} {
      allow read: if signedIn();
      allow write: if isDt() || isAdmin();
    }
    match /attendanceHistory/{recordId} {
      allow read: if signedIn();
      allow write: if isDt() || isAdmin();
    }

    // ---------- Catálogo configurable de eventos (US-09): lo edita solo el ADM ----------
    match /event_catalog/{eventTypeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Pruebas y convocatorias abiertas (US-10) ----------
    match /tryouts/{tryoutId} {
      allow read: if signedIn();
      allow create: if isDt() && request.resource.data.dtUid == me();
      allow update: if isAdmin()
                    || (isDt() && resource.data.dtUid == me())
                    // JUG/PAD solo suman su interés al contador
                    || (signedIn() && changed().hasOnly(['interestedCount']));
      allow delete: if isAdmin() || (isDt() && resource.data.dtUid == me());

      match /candidates/{candidateId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.userUid == me();
        allow update: if false;
        allow delete: if isAdmin()
                      || (isDt() && get(/databases/$(database)/documents/tryouts/$(tryoutId)).data.dtUid == me());
      }
    }
    match /tryoutReports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == me();
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.reporterUid == me()));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- Notificaciones: cualquiera las envía, solo el destinatario las lee ----------
    match /notifications/{notifId} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn() && resource.data.recipientUid == me();
    }

    // ---------- Solicitudes de anulación de eventos (US-20) ----------
    match /eventCancellationRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.get('requestingDtUid', '') == me();
      allow read: if isAdmin() || (signedIn() && resource.data.get('requestingDtUid', '') == me());
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
